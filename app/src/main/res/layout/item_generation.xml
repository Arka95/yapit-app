<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:background="@drawable/bg_card" android:padding="16dp" android:layout_marginBottom="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <TextView android:id="@+id/generationId" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textColor="@color/ink" android:textSize="14sp" android:textStyle="bold"/>
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_status" android:textColor="@color/accent" android:textSize="12sp" android:textStyle="bold"/>
    </LinearLayout>
    <TextView android:id="@+id/processingDetails" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="12sp" android:layout_marginTop="8dp"/>
    <TextView android:id="@+id/textPreview" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/ink" android:textSize="15sp" android:maxLines="3" android:ellipsize="end" android:layout_marginTop="12dp" android:focusable="true" android:tooltipText="@string/view_generation_text"/>
    <TextView android:id="@+id/modelName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/muted" android:textSize="12sp" android:layout_marginTop="8dp"/>
    <ImageView android:id="@+id/progress" android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/loading_yap_animation" android:contentDescription="@string/generation_loading" android:layout_marginTop="12dp"/>
    <LinearLayout android:id="@+id/audioActions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:visibility="gone" android:layout_marginTop="12dp">
        <com.google.android.material.button.MaterialButton android:id="@+id/playButton" style="@style/Widget.Yapit.IconButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:contentDescription="@string/play" android:tooltipText="@string/play" app:icon="@drawable/ic_play"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/shareButton" style="@style/Widget.Yapit.IconButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:contentDescription="@string/share" android:tooltipText="@string/share" app:icon="@drawable/ic_share"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/openFolderButton" style="@style/Widget.Yapit.IconButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:contentDescription="@string/open_in_folder" android:tooltipText="@string/open_in_folder" app:icon="@drawable/ic_folder"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/deleteGenerationButton" style="@style/Widget.Yapit.IconButton" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:contentDescription="@string/delete" android:tooltipText="@string/delete" app:icon="@drawable/ic_delete"/>
    </LinearLayout>
</LinearLayout>
