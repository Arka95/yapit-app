<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Yapit" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/surface</item>
        <item name="colorPrimaryContainer">@color/surface</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/surface</item>
        <item name="colorSecondaryContainer">@color/surface</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/surface</item>
        <item name="colorOnSurfaceVariant">@color/ink</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorError">@color/ink</item>
        <item name="colorOnError">@color/surface</item>
        <item name="colorOutline">@color/ink</item>
        <item name="colorOutlineVariant">@color/ink</item>
        <item name="colorControlNormal">@color/ink</item>
        <item name="colorControlActivated">@color/ink</item>
        <item name="materialButtonStyle">@style/Widget.Yapit.Button</item>
        <item name="textInputStyle">@style/Widget.Yapit.TextInputLayout</item>
        <item name="snackbarStyle">@style/Widget.Yapit.Snackbar</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink</item>
        <item name="android:textColorHint">@color/ink</item>
        <item name="android:forceDarkAllowed">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>

    <style name="Widget.Yapit.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/ink</item>
        <item name="android:textColor">@color/surface</item>
        <item name="iconTint">@color/surface</item>
        <item name="rippleColor">@color/ink</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Yapit.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/textbox_outline</item>
        <item name="boxStrokeErrorColor">@color/textbox_outline</item>
        <item name="android:textColorHint">@color/ink</item>
        <item name="hintTextColor">@color/ink</item>
        <item name="counterTextColor">@color/ink</item>
        <item name="counterOverflowTextColor">@color/ink</item>
        <item name="errorTextColor">@color/ink</item>
    </style>

    <style name="Widget.Yapit.OutlinedButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/ink</item>
        <item name="iconTint">@color/ink</item>
        <item name="strokeColor">@color/ink</item>
        <item name="rippleColor">@color/surface</item>
        <item name="android:textSize">12sp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="Widget.Yapit.IconButton" parent="Widget.Yapit.OutlinedButton">
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconPadding">0dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <style name="Widget.Yapit.Snackbar" parent="Widget.Material3.Snackbar">
        <item name="backgroundTint">@color/ink</item>
        <item name="android:textColor">@color/surface</item>
        <item name="backgroundOverlayColorAlpha">0</item>
        <item name="elevation">0dp</item>
    </style>
</resources>
